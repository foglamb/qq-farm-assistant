# 服务器本地增量构建：以已发布的运行镜像为底，只替换程序文件。
# Web 前端用预构建的 web/dist，AndroidPad 协议仍在本文件内自动编译。
#
#   bash build.sh
#   docker build -f core/Dockerfile.runtime -t qq-farm-four-channels:latest .
#
# 完整从零构建（CI 使用）：core/Dockerfile
ARG BASE_IMAGE=ghcr.io/foglamb/qq-farm-assistant:ondemand

# ---------- AndroidPad 协议 ----------
FROM mcr.microsoft.com/dotnet/sdk:8.0 AS pad
WORKDIR /src/pad-login
COPY pad-login/ ./
# 不跳过 restore：single-file 需要的 ILLink/运行时包只在带 RID 的完整还原里拉取。
RUN dotnet publish PadLogin.csproj -c Release -o /out -r linux-x64 \
    -p:PublishSingleFile=true -p:SelfContained=true \
    -p:IncludeNativeLibrariesForSelfExtract=true \
    -p:EnableCompressionInSingleFile=true

# ---------- 运行时 ----------
FROM ${BASE_IMAGE}

WORKDIR /app/core
ENV PAD_LOGIN_EXECUTABLE=/app/pad-login/PadLogin

COPY core /app/core
RUN rm -rf /app/web/dist
COPY web/dist /app/web/dist
COPY scripts /app/scripts
COPY --from=pad /out/PadLogin /app/pad-login/PadLogin
# Watch is the third scan channel: pure-Python, no signing service required.
# The base runtime image ships node only, so python3 comes from Debian.
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 \
    && rm -rf /var/lib/apt/lists/*
COPY vendor/watch-login /app/watch-login
ENV WATCH_LOGIN_COMPONENT_DIR=/app/watch-login \
    WATCH_LOGIN_PYTHON=python3
RUN node /app/core/qq-login/patch-napcat.cjs /opt/qq-login/napcat/napcat.mjs /opt/qq-login/napcat/napcat.mjs.next \
    && mv /opt/qq-login/napcat/napcat.mjs.next /opt/qq-login/napcat/napcat.mjs \
    && node --check /opt/qq-login/napcat/napcat.mjs \
    && chmod 755 /app/pad-login/PadLogin
